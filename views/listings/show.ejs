
<% layout("/layouts/boilerplate") %>
<body>
    <h3>Listing Details</h3>
    <ul>
        <li><%= listing.title %></li>
        <li><%= listing.description %></li>
        <!-- .toLocaleString help us to add commas according to our country, each country has their own standards to add commas and full stop -->
        <li>&#8377; <%= listing.price.toLocaleString("en-IN")%></li> 
        <li><%= listing.location %></li>
        <li><%= listing.country %></li>
        
    </ul>
    <br>
    <a href="/listings/<%= listing.id %>/edit">Edit this Listing</a>
    <br><br>
    <form method="POST" action="/listing/<%=listing._id%>?_method=DELETE">
        <button>Delete this listing</button>
    </form>

</body>
